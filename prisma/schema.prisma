generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

model User {
  id             String       @id @default(cuid())
  supabaseId     String       @unique
  name           String
  email          String       @unique
  isAdmin        Boolean      @default(false)
  isTrainer      Boolean      @default(false)
  isTrainerUser  Boolean      @default(false)
  trainerId      String?
  trainer        User?        @relation("TrainerUsers", fields: [trainerId], references: [id], onDelete: SetNull)
  trainerUsers   User[]       @relation("TrainerUsers")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  programs       Program[]
  workoutLogs    WorkoutLog[]

  @@index([trainerId])

  @@map("users")
}

model Program {
  id          String     @id @default(cuid())
  name        String
  description String?
  csvUrl      String?
  isActive    Boolean    @default(false)
  programType String     @default("primary")
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises   Exercise[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("programs")
}

model Exercise {
  id             String       @id @default(cuid())
  name           String
  muscleGroup    String
  day            String
  order          Int
  defaultSets    Int          @default(3)
  defaultReps    String       @default("10-12")
  notes          String?
  mediaUrl       String?
  detailImageUrl String?
  programId      String
  program        Program      @relation(fields: [programId], references: [id], onDelete: Cascade)
  workoutLogs    WorkoutLog[]
  createdAt      DateTime     @default(now())

  @@index([programId, day])
  @@map("exercises")
}

model WorkoutLog {
  id         String   @id @default(cuid())
  weight     Float
  sets       Int
  reps       Int
  durationSeconds Int?
  distanceKm Float?
  notes      String?
  loggedAt   DateTime @default(now())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([userId, exerciseId, loggedAt(sort: Desc)])
  @@map("workout_logs")
}

model ExerciseCatalog {
  id               String   @id
  exerciseName     String
  category         String
  primaryMuscles   String[]
  secondaryMuscles String[]
  equipment        String
  difficulty       String
  description      String
  instructions     String
  imageUrl         String?
  detailImageUrl   String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("exercise_catalog")
}
